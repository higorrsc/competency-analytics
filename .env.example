# ==============================================================================
# PERSONNEL COMPETENCY ANALYTICS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this template to .env and adjust values for your environment.
# Secrets should never be committed to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing. Generate a strong key in production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-in-production

# Debug mode (True for local development, False for staging and production).
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# Example: localhost,127.0.0.1,api.competency.corp.internal
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# Database engine backend. Options:
# - django.db.backends.postgresql (recommended for development and production)
# - django.db.backends.sqlite3 (used automatically by default in automated tests)
DATABASE_ENGINE=django.db.backends.postgresql

# Name of the database instance.
DATABASE_NAME=competency_analytics

# Database authentication credentials.
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Network location and port of the database host.
# Use 'db' when running within Docker Compose, or 'localhost' for local Postgres.
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# Localization & Internationalization
# ------------------------------------------------------------------------------
# Default language code for internationalization (e.g. en-us, pt-br).
LANGUAGE_CODE=en-us

# System timezone for datetime operations and database timestamp storage.
TIME_ZONE=UTC
